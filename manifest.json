{
  "name": "Screen Capture",
  "version": "3.0.0",
  "manifest_version": 3,
  "description": "Screen capture parts of your page, or the whole page in it's entirety, reliably!",
  "action": {
    "default_icon": "icon.png",
    "default_popup": "menu.html"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      }
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
